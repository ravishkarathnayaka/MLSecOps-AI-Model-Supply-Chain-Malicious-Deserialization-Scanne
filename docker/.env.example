# MLSecOps Scanner & Admission Controller Configuration

# Scanner API Host Port
SCANNER_PORT=8000

# Redis Cache Service
REDIS_HOST=redis
REDIS_PORT=6379

# Security Admission Thresholds
# Options: critical, high, medium, low, info
FAIL_ON_THRESHOLD=high

# Strict Mode Enforcement (rejects unknown non-standard globals)
STRICT_MODE=false

# Log Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
